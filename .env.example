# Copie para .env.local. Nunca commite segredos.
# Gere SESSION_SECRET com: openssl rand -hex 32
SESSION_SECRET=
# Mínimo de 12 caracteres. Senha exclusiva de /admin.
ADMIN_PASSWORD=

# Obrigatório na Vercel. Vazio no computador usa o arquivo .data/bosque.db.
# Crie o banco em https://turso.tech e copie a URL libsql:// e o token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional. Deixe as três vazias para usar o painel sem email.
# RESEND_API_KEY: chave privada em https://resend.com/api-keys
# RESEND_FROM: remetente verificado, por exemplo Bosque <presentes@seu-dominio.com>
# Enquanto o domínio não estiver verificado, use onboarding@resend.dev
# e coloque em NOTIFY_EMAIL o email da própria conta Resend.
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL=

# Geralmente vazio. Defina só se a origem pública for diferente da URL da requisição.
# Exemplo de produção: https://bosque.seudominio.com
APP_ORIGIN=
