# Copy to .dev.vars for local Cloudflare development. Never commit real secrets.
# Generate a cryptographically random secret with: openssl rand -hex 32
SESSION_SECRET=
# Minimum 12 characters; use a long unique password for /admin.
ADMIN_PASSWORD=

# Optional. Leave all three empty to use the admin dashboard without email.
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL=

# Usually empty. Only set this if a reverse proxy rewrites the request URL origin.
# Example: https://your-domain.example
APP_ORIGIN=
